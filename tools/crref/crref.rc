/* Ressource VERSION du harnais : la quadruple version de Game.exe 1.14d,
   RECOPIEE d'une mesure (VS_FIXEDFILEINFO MS=0x0001000e LS=0x00030047 =
   1.14.3.71, cf. tools/checkrevision_ref.py qui la lit dans le fichier).
   Sans elle, la DLL hacherait la version du harnais et la comparaison a la
   jambe runtime n'aurait aucun sens. */
1 VERSIONINFO
FILEVERSION    1,14,3,71
PRODUCTVERSION 1,14,3,71
FILEFLAGSMASK  0x3fL
FILEFLAGS      0x0L
FILEOS         0x40004L
FILETYPE       0x1L
FILESUBTYPE    0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileVersion", "1.14.3.71"
      VALUE "InternalName", "crref"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
